# Betmatic — copy to .env on the server. Never commit real values.

# ---- required ----
AUTH_SECRET=                                          # openssl rand -hex 32 (the app refuses to sign sessions without it)
CRON_SECRET=                                          # openssl rand -hex 24; the cron sidecar sends it as x-cron-secret
ADMIN_EMAIL=                                          # the admin account, created on first boot (signups are never admins)
ADMIN_PASSWORD=                                       # long random password
APP_URL=https://your-domain.com                       # public origin: Mercado Pago return/webhook URLs, share links, sitemap
NEXT_PUBLIC_BASE_URL=https://your-domain.com          # same origin; read at runtime (the image is built without .env)
ANTHROPIC_API_KEY=                                    # console.anthropic.com, with credit

# ---- cost and abuse ceilings ----
# AI_DAILY_BUDGET_USD=20                          # kill switch: recorded model spend per Brasília day; 0 switches AI off
# ON_DEMAND_DAILY_CAP=60                          # generations per day across all users (admin exempt)
# ON_DEMAND_USER_DAILY_CAP=20                     # per user per day when the plan sets no gamesPerDay
# REFERRAL_COINS=5                                # coins for each side on the referred user's first paid purchase
# REFERRAL_DAILY_CAP=3                            # paid referrals per referrer per day
# PROOF_MIN_DECIDED=30                            # decided tickets before hit rate / ROI are published

# ---- payments (Mercado Pago, BRL, prepaid) ----
MP_ACCESS_TOKEN=                                      # production access token; checkout is disabled while empty
# MP_WEBHOOK_SECRET=                              # "assinatura secreta" of the webhook in the MP dashboard; enables x-signature checks

# ---- company identity and support (legal pages show only what is set) ----
# LEGAL_NAME=                                     # legal name of the person or company running Betmatic
# LEGAL_DOCUMENT=                                 # CPF or CNPJ
# LEGAL_ADDRESS=                                  # address for notices
# LEGAL_EMAIL=                                    # e-mail for legal and data-protection requests
# SUPPORT_EMAIL=                                  # shown in the footer and contact page when set
# SUPPORT_WHATSAPP=                               # digits with country code, e.g. 55119XXXXXXXX; shown when set

# ---- models ----
# ANTHROPIC_MODEL=claude-opus-5                   # briefs/tickets
# ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5      # extractions and translations (cheaper)

# ---- background job ----
# CRON_ENABLED=0                                  # 0 = no background generation; games are built when someone opens them
# CRON_SPORTS=soccer-bra,soccer-esp,nba           # default: every sport except tennis
# CRON_MAX_GAMES=6                                # per sport per day
# CRON_LANGS=pt,en                                # first is generated by the judgement model; the rest are derived
# CRON_PREMATCH_REFRESH_HOURS=0                   # >0 regenerates once when kickoff is within N hours
# LEARN_AUTO_APPLY=0                              # 1 = the daily post-mortem applies its own prompt change
# TICKET_WEBHOOK_URL=                             # every generated game posts its top tickets here (whitelabelled)

# ---- telegram alerts (hidden while TELEGRAM_BOT_TOKEN is unset) ----
# TELEGRAM_BOT_TOKEN=                             # from @BotFather; then setWebhook to https://your-domain.com/api/telegram/webhook
# TELEGRAM_BOT_USERNAME=                          # without @
# TELEGRAM_WEBHOOK_SECRET=                        # required in production when the token is set; pass it as secret_token to setWebhook
# TELEGRAM_DIGEST_HOUR=9                          # Brasília hour after which the daily digest goes out
# TELEGRAM_TRANSPORT=bot                          # bot | file (tests)
