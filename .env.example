# ---- required ----
AUTH_SECRET=change-me-to-a-long-random-string        # openssl rand -hex 32
ANTHROPIC_API_KEY=sk-ant-...                          # console.anthropic.com — needs credit for the 4-hourly generation job
CRON_SECRET=change-me                                 # shared secret the cron sidecar uses to call /api/cron/refresh
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=choose-a-strong-password
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ---- payments ----
MP_ACCESS_TOKEN=APP_USR-...                           # Mercado Pago production token; webhook: /api/webhooks/mercadopago

# ---- optional ----
ANTHROPIC_MODEL=claude-opus-5                         # briefs/tickets
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5            # extractions (cheaper)

# ---- background job (token ceiling) ----
# CRON_SPORTS=soccer-bra,soccer-esp,nba          # default: every sport except tennis
# CRON_MAX_GAMES=6                                # per sport per day
# CRON_LANGS=pt,en                                # first is generated by the judgement model; the rest are derived by the cheaper one
# CRON_PREMATCH_REFRESH_HOURS=0                   # >0 regenerates once when kickoff is within N hours (fresh line-ups/odds); costs a second generation
# CRON_ENABLED=0                                  # 0 = no background generation; games are built when someone opens them
# ON_DEMAND_DAILY_CAP=60                          # circuit breaker: generations per day across all users
# ON_DEMAND_USER_DAILY_CAP=20                     # per user per day when the plan sets no gamesPerDay
# LEARN_AUTO_APPLY=0                              # 1 = the daily post-mortem applies its own prompt change; 0 = admin applies with one click
