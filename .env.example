# Betmatic — copy to .env on the server. Never commit real values.
# Keep every comment on its own line: docker compose reads `KEY=   # note` as the value "# note".

# ---- required ----
# openssl rand -hex 32 (the app refuses to sign sessions without it)
AUTH_SECRET=
# openssl rand -hex 24; the cron sidecar sends it as x-cron-secret
CRON_SECRET=
# the admin account, created on first boot (signups are never admins)
ADMIN_EMAIL=
# long random password
ADMIN_PASSWORD=
# public origin: Mercado Pago return/webhook URLs, share links, sitemap
APP_URL=https://your-domain.com
# same origin; read at runtime (the image is built without .env)
NEXT_PUBLIC_BASE_URL=https://your-domain.com
# console.anthropic.com, with credit (needed only while AI_PROVIDER is anthropic)
ANTHROPIC_API_KEY=
# Only for a key created at the organisation level (console → Settings → Workspaces → ID): a key
# created inside a workspace does not need it.
# ANTHROPIC_WORKSPACE_ID=

# ---- OpenAI (optional: one variable switches the whole app over) ----
# anthropic (default) | openai. Nothing changes until this says openai.
# AI_PROVIDER=openai
# platform.openai.com → API keys. Give the key a low monthly budget there too:
# that limit is OpenAI's own and holds even if this app is wrong about everything.
# OPENAI_API_KEY=
# Model ids. The defaults below are the cheap tier of the current generation —
# CONFIRM THEM AGAINST GET https://api.openai.com/v1/models WHEN THE KEY ARRIVES.
# The server logs a loud warning at boot when a configured id is not in the account's list.
# briefs/tickets — the only judgement call; $2 / $12 per 1M tokens in / out
# OPENAI_MODEL=gpt-5.6-terra
# extractions and translations; $0.20 / $1.20
# OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
# slip prints (vision), tipster messages, short write-ups, the player read; $0.20 / $1.20
# OPENAI_CHEAP_MODEL=gpt-5.6-luna
# the in-play read on the live panel; $0.20 / $1.20
# OPENAI_LIVE_MODEL=gpt-5.6-luna
# how hard the model thinks before answering: none | minimal | low | medium | high | xhigh | max,
# or "off" to send no reasoning field at all (needed by a non-reasoning model).
# Reasoning tokens bill at the output rate AND count against the output cap, so low is the default.
# OPENAI_REASONING_EFFORT=low

# ---- cost and abuse ceilings ----
# kill switch: recorded model spend per Brasília day; 0 switches AI off. Applies to admins too.
# AI_DAILY_BUDGET_USD=20
# generations per day across all users (admins have their own cap, below)
# ON_DEMAND_DAILY_CAP=60
# per user per day when the plan sets no gamesPerDay
# ON_DEMAND_USER_DAILY_CAP=20
# games AND cross-game slates per admin per day, each on its own count. 0 stops an admin login dead.
# Set this before handing an admin login to someone else.
# ADMIN_GAMES_PER_DAY=15          # jogos por dia de cada admin; `unlimited` (ou -1) tira o limite, `0` bloqueia
# coins for each side on the referred user's first paid purchase
# REFERRAL_COINS=5
# paid referrals per referrer per day
# REFERRAL_DAILY_CAP=3
# decided tickets before hit rate / ROI are published
# PROOF_MIN_DECIDED=30

# ---- payments (Mercado Pago, BRL, prepaid) ----
# production access token; checkout is disabled while empty
MP_ACCESS_TOKEN=
# "assinatura secreta" of the webhook in the MP dashboard: a wrong x-signature is refused, an unsigned delivery is logged and re-read from the API
# MP_WEBHOOK_SECRET=

# ---- company identity and support (legal pages show only what is set) ----
# legal name of the person or company running Betmatic
# LEGAL_NAME=
# CPF or CNPJ
# LEGAL_DOCUMENT=
# address for notices
# LEGAL_ADDRESS=
# e-mail for legal and data-protection requests
# LEGAL_EMAIL=
# shown in the footer and contact page when set
# SUPPORT_EMAIL=
# digits with country code, e.g. 55119XXXXXXXX; shown when set
# SUPPORT_WHATSAPP=

# ---- models (anthropic; the openai ones are in the OpenAI section above) ----
# briefs/tickets
# ANTHROPIC_MODEL=claude-opus-5
# extractions and translations (cheaper)
# ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
# mechanical passes: slip prints (vision), tipster messages, short write-ups, the player read
# ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5
# the in-play read on the live panel
# ANTHROPIC_LIVE_MODEL=claude-sonnet-5

# ---- round 3 caps (all optional; defaults shown) ----
# games the system generates by itself each day ("destaques do dia"); 0 turns it off
# FEATURED_PER_DAY=3
# sports the featured job looks at (default: every sport that sells tickets)
# FEATURED_SPORTS=soccer-bra,nba,wnba
# cross-game parlays on request: per day overall, per user, and games per slate.
# The scheduler's own daily build (job=cross) does not count against SLATE_DAILY_CAP: it is the
# platform's bill, bounded by its once-a-day guard and by AI_DAILY_BUDGET_USD.
# SLATE_DAILY_CAP=5
# SLATE_USER_DAILY_CAP=2
# SLATE_MAX_GAMES=6
# "as múltiplas do dia entre jogos": built once a Brasília day for every sport with two upcoming
# games or more, in the short window of src/lib/bets/cross-policy.ts. 0 switches the daily build off
# (the reader's own button still works).
# CROSS_DAILY=1
# Max plan "atualizar os bilhetes": per user and overall per day
# MAX_REFRESH_PER_DAY=3
# REFRESH_DAILY_CAP=10
# live reads per day overall (Pro/Max, one per game per 15 min)
# LIVE_READS_DAILY_CAP=40
# slip prints: free per day, paid per day; model calls overall per day (an unreadable print counts)
# SCAN_FREE_PER_DAY=3
# SCAN_PAID_PER_DAY=20
# SCAN_DAILY_CAP=300
# model calls per account per day, failed ones included
# SCAN_TRIES_FREE_PER_DAY=6
# SCAN_TRIES_PAID_PER_DAY=40
# tipster audit: model calls per account per day (failed and empty ones included) and overall per day
# TIPSTER_TRIES_FREE_PER_DAY=3
# TIPSTER_TRIES_PAID_PER_DAY=10
# TIPSTER_DAILY_CAP=100
# on-demand generation per day overall and per user (Max may go 50% past the overall cap),
# and per admin (admins skip the two above, never this one)
# ON_DEMAND_DAILY_CAP=60
# ON_DEMAND_USER_DAILY_CAP=20
# ADMIN_GAMES_PER_DAY=15          # jogos por dia de cada admin; `unlimited` (ou -1) tira o limite, `0` bloqueia

# ---- background job ----
# 0 = no background generation; games are built when someone opens them
# CRON_ENABLED=0
# default: every sport except tennis
# CRON_SPORTS=soccer-bra,soccer-esp,nba
# per sport per day
# CRON_MAX_GAMES=6
# first is generated by the judgement model; the rest are derived
# CRON_LANGS=pt,en
# >0 regenerates once when kickoff is within N hours
# CRON_PREMATCH_REFRESH_HOURS=0
# 1 = the daily post-mortem applies its own prompt change
# LEARN_AUTO_APPLY=0
# every generated game posts its top tickets here (whitelabelled)
# TICKET_WEBHOOK_URL=

# ---- Brazilian books (?job=books: prices of every game in the next 48 h, pre-game only) ----
# OFF until this is set: the sidecar calls the job every tick, and a deploy that never edited its
# .env must not start reading seven hosts. `all` = every adapter; a comma list names them.
# Read through the public JSON each book's own site calls, one request per second per host, no
# token, no cookie, no evasion of any kind (see src/lib/sources/br-books/registry.ts).
# ids: superbet, kambi:kto, altenar:estrelabet, altenar:apostaganha, altenar:betpix365,
#      altenar:lotogreen, altenar:vaidebet, betfair-exchange, sportingbet, betnacional
# BR_BOOKS=superbet,kambi:kto,altenar:estrelabet,betfair-exchange
# a player line is "out of step" when a book sits this far (%) from the median of the other feeds;
# 7 = a whole two-way margin (1.87/1.87 is 6.9% overround), so it is value, not rounding or timing
# BOOKS_DISPERSION_PCT=7
# how far ahead the job looks for events
# BOOKS_HORIZON_HOURS=48
# one adapter may not hold the tick longer than this (its requests are aborted at the deadline)
# BOOKS_ADAPTER_TIMEOUT_MS=90000
# the whole tick's budget; adapters whose turn comes later wait for the next tick
# BOOKS_JOB_BUDGET_MS=480000
# days of price history kept after kickoff (older games are deleted with their rows)
# BOOKS_RETENTION_DAYS=14
# Affiliate tag per book, appended verbatim to that book's "Abrir na casa" links (a query fragment,
# "btag=…" or "utm_source=…&utm_medium=…"; a value starting with "#" is a hash fragment). The suffix
# is the book's name in upper snake case: SUPERBET, KTO, BETFAIR_EXCHANGE, SPORTINGBET, BETNACIONAL,
# ESTRELABET, APOSTA_GANHA, BETPIX365, LOTOGREEN, VAIDEBET (src/lib/sources/br-books/deeplinks.ts).
# Empty or unset = no tag. Nothing about the reader ever enters a link.
# BOOK_AFFILIATE_SUPERBET=
# BOOK_AFFILIATE_KTO=
# BOOK_AFFILIATE_BETFAIR_EXCHANGE=
# BOOK_AFFILIATE_SPORTINGBET=
# BOOK_AFFILIATE_BETNACIONAL=

# ---- telegram alerts (hidden while TELEGRAM_BOT_TOKEN is unset) ----
# from @BotFather; then setWebhook to https://your-domain.com/api/telegram/webhook
# TELEGRAM_BOT_TOKEN=
# without @
# TELEGRAM_BOT_USERNAME=
# required in production when the token is set; pass it as secret_token to setWebhook
# TELEGRAM_WEBHOOK_SECRET=
# Brasília hour after which the daily digest goes out
# TELEGRAM_DIGEST_HOUR=9
# bot | file (tests)
# TELEGRAM_TRANSPORT=bot

# Basketball: a live read is taken by itself at every quarter break for every game with a pre-game
# slate (the quarters job on the cron). 0 switches it off; the reads count against the AI budget.
# LIVE_QUARTER_READS=1

# Output room for one slate (the model's thinking counts against it on Claude). Default 32000; a
# truncated read is logged as game[max_tokens] in the AI usage panel.
# AI_MAX_OUTPUT_TOKENS=48000

# How hard Claude may think per read (low | medium | high | xhigh | max). Unbounded thinking on Opus 5
# spent the whole output budget thinking; the read's numbers are computed in code. Default high.
# ANTHROPIC_EFFORT=high

# Every ticket of a game by mail to the operators, each time a new read comes out (pre-game first,
# then every live read with its quarter; name, lines and price only). Needs SMTP: a Gmail account
# with an app password works (smtp.gmail.com, 465, the address, the 16-character app password).
# TICKET_EMAIL_TO=you@example.com,partner@example.com
# TICKET_EMAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
